# Copie ce fichier en .env.local et remplis les valeurs.
# .env.local est gitignore (pattern *.local) -- il ne partira JAMAIS sur GitHub.
# Sur Vercel, ces memes variables se definissent dans Settings > Environment Variables.

# Provider actif : groq | openrouter | gemini | cerebras
LLM_PROVIDER=

# La cle du provider choisi (une seule est necessaire)
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# CEREBRAS_API_KEY=

# Optionnel : force un modele precis au lieu du defaut du provider
# LLM_MODEL=
